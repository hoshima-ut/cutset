#!/usr/bin/env python3
"""Inspect index objects or the history a push would introduce. Never log payloads."""

import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


class Blocked(Exception):
    """The action must stop. Only use static diagnostic text."""


def git(*args, optional=False):
    result = subprocess.run(
        ["git", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        env={**os.environ, "GIT_NO_REPLACE_OBJECTS": "1"},
    )
    if result.returncode and not optional:
        raise Blocked("Git objects or history could not be inspected.")
    return None if result.returncode else result.stdout


def object_id(value):
    if not re.fullmatch(rb"[a-f0-9]{40}|[a-f0-9]{64}", value):
        raise Blocked("Invalid Git object ID.")
    return value


def denied(path):
    parts = [p.lower() for p in path.split(b"/")]
    name = parts[-1]
    return (
        name == b".env" or name.startswith(b".env.")
        or name in {b".git-credentials", b".pgpass", b".envrc", b"id_rsa", b"id_dsa", b"id_ecdsa", b"id_ed25519", b".netrc",
                    b"_netrc", b".npmrc", b".pypirc", b"credentials.json",
                    b"application_default_credentials.json", b"terraform.tfstate"}
        or name.endswith((b".pem", b".key", b".p12", b".pfx", b".jks", b".keystore",
                          b".kdbx", b".p8", b".ppk", b".tfstate", b".tfstate.backup"))
        or parts[-2:] in ([b".aws", b"credentials"], [b".docker", b"config.json"],
                          [b".kube", b"config"])
    )


def collect_changes(raw, blobs, names):
    fields = raw.split(b"\0")
    if fields.pop() or len(fields) % 2:
        raise Blocked("Unrecognized Git change list.")
    for header, path in zip(fields[::2], fields[1::2]):
        fields_header = header.split()
        if len(fields_header) != 5 or not fields_header[0].startswith(b":"):
            raise Blocked("Unrecognized Git change record.")
        if denied(path):
            raise Blocked("Credential filename detected. Inspect changed paths locally.")
        if fields_header[1] not in (b"100644", b"100755", b"120000"):
            raise Blocked("Nested repositories or unresolved entries require separate review.")
        blobs.add(object_id(fields_header[3]))
        names.add(path)


DIFF_ARGS = ["--raw", "-z", "--no-abbrev", "--no-renames", "--no-relative", "--no-ext-diff",
             "--no-textconv", "--diff-filter=ACMTU"]


def remote_commits(url):
    # Only subtract commits actually advertised by this destination. Local tracking
    # refs can be stale or belong to a different remote. An offline lookup costs a
    # full scan instead of skipping any history.
    tips = git("ls-remote", "--refs", "--heads", "--tags", "--", url, optional=True)
    known = set()
    for line in (tips or b"").splitlines():
        remote_oid = object_id(line.split(b"\t", 1)[0])
        tip = git("rev-parse", "--verify", remote_oid + b"^{commit}", optional=True)
        if tip:
            known.add(object_id(tip.strip()))
    return known


def public_sources():
    """Reviewed public repositories this fork tracks, from tools/public-sources.txt in the
    repository being pushed. Local remotes and Git config are never trusted for this."""
    top = git("rev-parse", "--show-toplevel", optional=True)
    if not top:
        return []
    listing = Path(os.fsdecode(top.strip())) / "tools" / "public-sources.txt"
    if not listing.is_file():
        return []
    lines = listing.read_text(encoding="utf-8").splitlines()
    return [line.strip() for line in lines if line.strip() and not line.lstrip().startswith("#")]


def published_blobs(tips):
    """Blob IDs in the trees of already published commits: content that is public already."""
    blobs = set()
    for tip in sorted(tips):
        for entry in (git("ls-tree", "-r", "-z", "--full-tree", tip, optional=True) or b"").split(b"\0"):
            fields = entry.split(b"\t", 1)[0].split()
            if len(fields) == 3 and fields[1] == b"blob":
                blobs.add(object_id(fields[2]))
    return blobs


def commits_for_push(url, sink):
    commits, names, old = set(), set(), set()
    for record in sys.stdin.buffer:
        fields = record.split()
        if len(fields) != 4:
            raise Blocked("Invalid pre-push ref list.")
        local_ref, local_oid, remote_ref, remote_oid = fields
        object_id(local_oid)
        object_id(remote_oid)
        if not local_oid.strip(b"0"):
            continue  # Deleting a ref sends no new content.
        names.update([local_ref, remote_ref])
        if remote_oid.strip(b"0"):
            resolved = git("rev-parse", "--verify", remote_oid+b"^{commit}", optional=True)
            if resolved:
                old.add(object_id(resolved.strip()))
        oid = local_oid
        kind = git("cat-file", "-t", oid).strip()
        while kind == b"tag":
            tag = git("cat-file", "tag", oid)
            sink.write(tag + b"\n")
            oid = object_id(tag.splitlines()[0].removeprefix(b"object "))
            kind = git("cat-file", "-t", oid).strip()
        if kind != b"commit":
            raise Blocked("Only commit targets can be verified for transfer.")
        commits.add(oid)
    if not commits:
        return [], names, set()
    if git("rev-parse", "--is-shallow-repository").strip() != b"false":
        raise Blocked("Fetch complete history before pushing.")
    if Path(os.fsdecode(git("rev-parse", "--git-path", "info/grafts").strip())).exists():
        raise Blocked("Complete, ungrafted history is required.")
    old.update(remote_commits(url))
    public = set()
    for source in public_sources():
        public.update(remote_commits(source))
    old.update(public)
    return [*sorted(commits), *(b"^"+oid for oid in sorted(old))], names, public


def visible_text(data):
    if b"\0" not in data:
        try:
            data.decode("utf-8")
            return data
        except UnicodeDecodeError:
            pass
    # Preserve visible ASCII and common UTF-16 credential strings in binary
    # metadata. This does not decode encrypted archives, images or media streams.
    fragments = re.findall(rb"[\x20-\x7e]{6,}", data)
    for pattern in (rb"(?:[\x20-\x7e]\x00){6,}", rb"(?:\x00[\x20-\x7e]){6,}"):
        fragments.extend(s.replace(b"\0", b"") for s in re.findall(pattern, data))
    return b"\n".join(fragments)


def scan_objects(blobs, directory):
    # cat-file retrieves the exact staged/historical content even if the working
    # copy differs. Neutral names avoid executing filters or following symlinks.
    with subprocess.Popen(
        ["git", "cat-file", "--batch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, env={**os.environ, "GIT_NO_REPLACE_OBJECTS":"1"},
    ) as cat:
        try:
            for oid in sorted(blobs):
                cat.stdin.write(oid+b"\n")
                cat.stdin.flush()
                header = cat.stdout.readline().split()
                if len(header) != 3 or header[0] != oid or header[1] != b"blob":
                    raise Blocked("A changed blob could not be read.")
                size = int(header[2])
                if size > 100 * 1024 * 1024:
                    raise Blocked("Blob exceeds the scanner's 100 MiB per-object limit.")
                data = cat.stdout.read(size)
                if len(data) != size or cat.stdout.read(1) != b"\n":
                    raise Blocked("Incomplete Git object.")
                if re.match(rb"version https://(?:git-lfs|hawser)\.github\.com/spec/v1\r?\n", data):
                    raise Blocked("Git LFS payload is external and was not inspected.")
                if data.startswith((b"PK\x03\x04", b"PK\x05\x06", b"PK\x07\x08",
                                    b"\x1f\x8b", b"BZh", b"7z\xbc\xaf\x27\x1c",
                                    b"Rar!\x1a\x07", b"\xfd7zXZ\x00", b"\x28\xb5\x2f\xfd")) or data[257:262] == b"ustar":
                    raise Blocked("Archive contents need separate inspection before inclusion.")
                (directory / (oid.decode()+".txt")).write_bytes(visible_text(data))
        finally:
            cat.stdin.close()
        if cat.wait() != 0:
            raise Blocked("Git object reader failed.")


def run():
    mode = sys.argv[1:]
    if mode != ["staged"] and not (len(mode)==3 and mode[0]=="pre-push"):
        raise Blocked("Usage: secret-guard staged | pre-push REMOTE URL")
    git("rev-parse","--git-dir")
    blobs, names = set(), set()
    with tempfile.TemporaryDirectory(prefix="cutset-secret-") as temp:
        work = Path(temp)
        inputs = work/"inputs"
        inputs.mkdir()
        with (inputs/"metadata.txt").open("wb") as sink:
            if mode == ["staged"]:
                raw = git("diff", "--cached", *DIFF_ARGS)
            else:
                revisions, names, public = commits_for_push(mode[2], sink)
                raw = b""
                if revisions:
                    raw = git("log", "--format=", "--root", "--full-history", "-m",
                              *DIFF_ARGS, *revisions, "--")
                    sink.write(git("log", "--format=%an%n%ae%n%cn%n%ce%n%B", "--full-history", *revisions, "--"))
            collect_changes(raw, blobs, names)
            if mode != ["staged"]:
                # A merge of a published upstream lists the upstream's files against the
                # fork's parent; content identical to a published tree is not new.
                blobs -= published_blobs(public)
            for name in sorted(names):
                sink.write(b"\n"+name+b"\n")
        scan_objects(blobs, inputs)
        # Ignore neither repository comments nor local ignore/baseline config.
        config = work/"rules.toml"
        config.write_text("[extend]\nuseDefault = true\n")
        empty_ignore = work/".gitleaksignore"
        empty_ignore.touch()
        env = {k:v for k,v in os.environ.items() if not k.startswith("GITLEAKS_")}
        result = subprocess.run(
            ["gitleaks", "dir", "--config", str(config), "--gitleaks-ignore-path",
             str(empty_ignore), "--ignore-gitleaks-allow", "--redact=100", "--no-banner",
             "--log-level", "error", "--exit-code", "42", str(inputs)],
            cwd=work, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if result.returncode == 42:
            raise Blocked("Possible secret detected. Inspect the index or outgoing history locally.")
        if result.returncode:
            raise Blocked("Gitleaks failed. Install Gitleaks 8.30.1 or compatible and retry.")
    print("Cutset secret check passed.")


if __name__ == "__main__":
    try:
        run()
    except Blocked as error:
        print(f"Cutset: {error}", file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, IndexError):
        print("Cutset secret check could not finish. Check Git, Python 3.9+, Gitleaks, and disk space.",file=sys.stderr)
        sys.exit(2)
